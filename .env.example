# Optional OpenAI-compatible chat API.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional future embedding/reranker endpoints.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_DEVICE=cpu
HF_LOCAL_FILES_ONLY=0
USE_FLAGEMBEDDING=
FLAGEMBEDDING_REPO_PATH=
RERANKER_API_KEY=
RERANKER_BASE_URL=
RERANKER_MODEL=
RERANKER_PATH=/rerank
LOCAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=
RERANKER_WEIGHT=0.25

# Optional stronger/larger embedding model:
# LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
# USE_FLAGEMBEDDING=1

# Optional LLM-based retrieval/query and answer verification.
ENABLE_QUERY_ENHANCEMENT=
QUERY_ENHANCEMENT_MODE=rewrite
ENABLE_LLM_VERIFIER=
